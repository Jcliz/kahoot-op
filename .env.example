# Copie para .env.local e preencha. Nunca versione o .env.local.

# Supabase (preenchidas pela integração do Marketplace da Vercel)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só servidor. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Só servidor. Segredo JWT do projeto (Settings > API > JWT Secret),
# usado para emitir o token que só permite ESCUTAR o canal da sessão.
SUPABASE_JWT_SECRET=

# Apresentador
HOST_PASSWORD=
# Segredo longo e aleatório (ex.: openssl rand -base64 48)
HOST_SESSION_SECRET=

# Bônus de sequência de acertos (true/false)
STREAK_BONUS=false

# URL pública mostrada no lobby e usada no QR code (ex.: https://quiz.exemplo.com)
NEXT_PUBLIC_APP_URL=

# Desenvolvimento local sem Supabase: "memory" guarda tudo na memória do processo
# (só funciona com um único processo, nunca em produção). Padrão: supabase.
DATA_BACKEND=
